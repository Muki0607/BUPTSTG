7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.huge_row_y = lstg.world.t + self.huge_row_radius + 1 -- 整颗弹幕从画面上方进入","EditWindow":"code"}],"AttributeCount":1}
