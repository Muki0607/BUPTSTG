8,{"$type":".General.Repeat, LuaSTGEditorSharp","Attributes":[{"attrCap":"Times","attrInput":"_infinite","EditWindow":"yield"},{"$type":".DependencyAttrItem, ","attrCap":"Number of Var","attrInput":"0","EditWindow":""}],"AttributeCount":2}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local l1 = self.l1\r\nlocal l2 = self.l2\r\nlocal l3 = self.l3\r\nlocal angle1 = angle % 360\r\nlocal r1 = 80\r\n\r\n-- 激光方向向量\r\nlocal dir_x = cos(angle1)\r\nlocal dir_y = sin(angle1)\r\n\r\n-- 玩家相对发射源的向量\r\nlocal dx = player.x - self.x\r\nlocal dy = player.y - self.y\r\nlocal dist_player_sq = dx^2 + dy^2\r\n\r\n-- 射线方程：P = self + t * dir，求与玩家判定圆的交点\r\n-- |P - player|^2 = r1^2\r\n-- 展开成关于t的二次方程：at^2 + bt + c = 0\r\nlocal a = dir_x^2 + dir_y^2  -- 实际上 = 1\r\nlocal b = 2 * (self.x * dir_x - player.x * dir_x + self.y * dir_y - player.y * dir_y)\r\nlocal c = dist_player_sq - r1^2\r\n\r\n-- 判别式\r\nlocal discriminant = b^2 - 4*a*c\r\n\r\nif discriminant >= 0 and c < 0 then\r\n    -- 有交点，且发射源在圆内或圆边缘（c<0表示发射源到玩家距离<r1，或者刚好等于）\r\n    -- 取较小的t（最近的交点）\r\n    local t = (-b - sqrt(discriminant)) / (2*a)\r\n    \r\n    if t > 0 then\r\n        -- 交点在激光前方\r\n        self.head_x = self.x + t * dir_x\r\n        self.head_y = self.y + t * dir_y\r\n        self.l2 = t - l1 - l3\r\n        self.is_contact = 1\r\n    else\r\n        self.l2 = 500\r\n        self.is_contact = 0\r\n    end\r\nelseif discriminant >= 0 then\r\n    -- 有交点，发射源在圆外\r\n    local t = (-b - sqrt(discriminant)) / (2*a)\r\n    \r\n    if t > 0 then\r\n        -- 检查玩家是否在激光圆柱体判定内\r\n        local proj = dx * dir_x + dy * dir_y  -- 玩家在激光方向上的投影\r\n        if proj > 0 then\r\n            local perp_dist_sq = dist_player_sq - proj^2  -- 垂直距离的平方\r\n            if perp_dist_sq <= r1^2 then\r\n                -- 在圆柱体内\r\n                self.head_x = self.x + t * dir_x\r\n                self.head_y = self.y + t * dir_y\r\n                self.l2 = t - l1 - l3\r\n                self.is_contact = 1\r\n            else\r\n                self.l2 = 500\r\n                self.is_contact = 0\r\n            end\r\n        else\r\n            self.l2 = 500\r\n            self.is_contact = 0\r\n        end\r\n    else\r\n        self.l2 = 500\r\n        self.is_contact = 0\r\n    end\r\nelse\r\n    -- 无交点\r\n    self.l2 = 500\r\n    self.is_contact = 0\r\nend\r\n","EditWindow":"code"}],"AttributeCount":1,"IsExpanded":false}
