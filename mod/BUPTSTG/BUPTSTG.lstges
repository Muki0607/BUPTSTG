6,{"$type":".Object.SetVelocity, ","Attributes":[{"attrCap":"Target","attrInput":"self","EditWindow":"target"},{"attrCap":"Velocity","attrInput":"speed","EditWindow":"velocity"},{"attrCap":"Angle","attrInput":"angle","EditWindow":"rotation"},{"attrCap":"Aim to Player","attrInput":"false","EditWindow":"bool"},{"attrCap":"Set Rotation","attrInput":"true","EditWindow":"bool"}],"AttributeCount":5}
4,{"$type":".Bullet.BulletDefine, ","Attributes":[{"attrCap":"Name","attrInput":"BD_Wolf","EditWindow":""},{"attrCap":"Difficulty","attrInput":"All","EditWindow":"objDifficulty"}],"AttributeCount":2,"IsExpanded":false}
5,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"绿色狼弹使用enm7.png第10行三帧循环。左侧朝右跑、右侧水平翻转朝左跑；判定与速度保留原设定。","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2}
