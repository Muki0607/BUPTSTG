7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.huge_row_horizontal_speed = 64 / 120 -- 120帧移动一个大玉直径（64游戏坐标）","EditWindow":"code"}],"AttributeCount":1}
