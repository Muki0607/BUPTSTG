7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_stop_jitter = 8 -- 各颗子弹各自浮动±8","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_pause_min = 60 -- 停顿至少1秒","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_pause_max = 120 -- 停顿至多2秒","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_rearm_frames = 60 -- 第一次恢复后至少继续追踪1秒，避免连续停两次","EditWindow":"code"}],"AttributeCount":1}
