5,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"--------------------------------------------------------------------------------\r\n--- 独立符卡名横幅（从 boss.sc_name 抽出，去掉 boss 依赖与历史记录）\r\n--- 坐标系：世界坐标（与 boss.sc_name 一致，不调 SetViewMode）\r\n---   → 作为普通 object 在 ObjRender 阶段渲染，用的就是 world 视图\r\n---   → self.x/self.y 与 player.x/player.y 同一坐标系，可直接比较\r\n--- 位置参考 boss 符卡名（终点 x=192、从右侧 +200 滑入），最终 y 默认更低\r\n--- 保留原版“自机靠近淡出、离开恢复”机制\r\n---\r\n--- 用法：\r\n---   Include('THlib/player/hifuu/merry/spellcard_name_banner.lua')\r\n---   New(aya_sp_name_banner, \"神奈川冲浪里\")            -- 全默认，位置比 boss 符卡名低\r\n---   New(aya_sp_name_banner, \"神奈川冲浪里\", 192, 150)  -- 指定终点 (192,150)\r\n---\r\n--- 复用的全局资源（THlib 已加载）：\r\n---   贴图 boss_spell_name_bg（右对齐锚点 256×36）、TTF 字体 sc_name\r\n--------------------------------------------------------------------------------\r\n\r\n-- boss 符卡名横幅的基准（世界坐标，见 boss_ui.lua 的 sc_name）\r\nlocal BOSS_SC_X       = 192  -- boss 符卡名终点 x（世界坐标，右边缘）\r\nlocal BOSS_SC_Y       = 236  -- boss 符卡名终点 y\r\nlocal BOSS_SC_XOFFSET = 200  -- 从右侧滑入的初始横向偏移\r\n-- 本横幅最终 y 比 boss 符卡名低的量（世界坐标 y 向上，正数=更靠下）\r\nlocal LOWER_BY        = 45\r\n\r\n---@class aya_sp_name_banner\r\naya_sp_name_banner = Class(object)\r\n\r\n--- 初始化（不传的参数一律回退到 boss 符卡名基准，最终 y 自动放低）\r\n---@param text string       显示文本\r\n---@param x1 number|nil      最终 x（默认 192，同 boss 符卡名）\r\n---@param y1 number|nil      最终 y（默认 boss 符卡名 y - LOWER_BY）\r\n---@param x0 number|nil      起始 x（默认 = 最终 x + 200，同 boss 从右滑入）\r\n---@param y0 number|nil      起始 y（默认 = 最终 y）\r\n---@param move_time number|nil  滑入用时（帧），默认 30\r\n---@param hold_time number|nil  停留时长（帧）；nil = 常驻直到手动 Del\r\nfunction aya_sp_name_banner:init(text, x1, y1, x0, y0, show_time, move_time, hold_time)\r\n    self.layer = LAYER_TOP + 1\r\n    self.group = GROUP_GHOST\r\n    self.bound = false\r\n\r\n    self.text = text or \"\"\r\n    -- 最终位置：参考 boss 符卡名，y 默认放低\r\n    self.x1 = x1 or BOSS_SC_X\r\n    self.y1 = y1 or (BOSS_SC_Y - LOWER_BY)\r\n    -- 起始位置：默认与 boss 一样从右侧滑入（终点 + 横向偏移），y 与终点同高\r\n    self.x0 = x0 or (self.x1 + BOSS_SC_XOFFSET)\r\n    self.y0 = y0 or self.y1\r\n    self.show_time = show_time or 30\r\n    self.move_time = move_time or 30\r\n    self.hold_time = hold_time -- nil 则常驻\r\n\r\n    self.x = self.x0\r\n    self.y = self.y0\r\n    self._alpha  = 0   -- 整体透明度 0-1\r\n    self._scale  = 5   -- 文字初始放大（回弹到 1，制造“啪”地弹出感）\r\n    self._scale2 = 1   -- 背景条附加缩放系数（1→0）\r\n    self.flag    = 0   -- 自机靠近计数（0~18），越大越淡\r\nend\r\n\r\nfunction aya_sp_name_banner:frame()\r\n\tlocal st = self.show_time\r\n    local mt = self.move_time\r\n    local t  = self.timer\r\n\r\n    if t <= st then\r\n        -- 滑入 + 缩放回弹（sin 为角度制，sin(90*p) 实现缓出）\r\n        local p = t / (st)\r\n        local e = sin(90 * p)\r\n        self._alpha  = p\r\n        self._scale  = 1 + 4 * (1 - e) -- 5 → 1\r\n        self._scale2 = 1 - e           -- 1 → 0\r\n    elseif t <= mt + st then\r\n    \tlocal p = (t - st) / (mt)\r\n        local e = sin(90 * p)\r\n    \tself.x = self.x0 + (self.x1 - self.x0) * e\r\n        self.y = self.y0 + (self.y1 - self.y0) * e\r\n    else\r\n        self.x = self.x1\r\n        self.y = self.y1\r\n        self._alpha  = 1\r\n        self._scale  = 1\r\n        self._scale2 = 0\r\n    end\r\n\r\n    -- 自机靠近淡出、离开恢复（照抄 boss.sc_name 逻辑，世界坐标直接比较）\r\n    -- flag 每帧 ±1，夹在 0~18；render 时 alpha 乘 (1 - flag/30)，最低约 0.4\r\n    local near = false\r\n    if t > mt and IsValid(player)\r\n            and abs(player.x - self.x) <= 180\r\n            and abs(player.y - self.y) <= 60 then\r\n        near = true\r\n    end\r\n    if near then\r\n        self.flag = self.flag + 1\r\n    else\r\n        self.flag = self.flag - 1\r\n    end\r\n    self.flag = min(max(0, self.flag), 18)\r\n\r\n    -- 有停留时长则到点淡出并自删；否则常驻，需外部 Del\r\n    if self.hold_time and t > mt + self.hold_time then\r\n        self._alpha = self._alpha - 1 / 20\r\n        if self._alpha <= 0 then\r\n            Del(self)\r\n        end\r\n    end\r\nend\r\n\r\nfunction aya_sp_name_banner:render()\r\n    -- 不调 SetViewMode：与 boss.sc_name 一致，用 ObjRender 阶段的世界视图\r\n\r\n    -- 靠近淡出系数（1 = 正常，最低约 0.4）\r\n    local near_fade = 1 - self.flag / 30\r\n    local a = self._alpha * near_fade * 255\r\n\r\n    -- 背景条（锚点右对齐 256 宽，故向 self.x 左侧延伸）\r\n    SetImageState(\"boss_spell_name_bg\", \"\", Color(a, 255, 255, 255))\r\n    Render(\"boss_spell_name_bg\", self.x, self.y, 0, 1 + 0.5 * self._scale2)\r\n\r\n    -- 文字：先画 8 方向黑描边，再画白字（与原版一致）\r\n    local ty = self.y - 10\r\n    local s = GetImageScale()\r\n    SetImageScale(s * self._scale)\r\n    local d = sqrt(2)\r\n    for i = 0, 8 do\r\n        local _x = self.x + d * cos(i * 45)\r\n        local _y = ty + d * sin(i * 45)\r\n        RenderTTF(\"main_font_zh_cn\", self.text,\r\n                _x, _x, _y - 2, _y - 2,\r\n                Color(a, 0, 0, 0),\r\n                \"right\", \"noclip\")\r\n    end\r\n    RenderTTF(\"main_font_zh_cn\", self.text,\r\n            self.x, self.x, ty - 2, ty - 2,\r\n            Color(a, 255, 255, 255),\r\n            \"right\", \"noclip\")\r\n    SetImageScale(s)\r\nend\r\n","EditWindow":"code"}],"AttributeCount":1,"IsExpanded":false}
