6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"第一部分发弹：每60帧生成一整排绿色ball_huge","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local row_direction = -1 -- 第一排向左，下一排向右","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Repeat, LuaSTGEditorSharp","Attributes":[{"attrCap":"Times","attrInput":"_infinite","EditWindow":"yield"},{"$type":".DependencyAttrItem, ","attrCap":"Number of Var","attrInput":"1","EditWindow":""},{"attrCap":"Var 1 name","attrInput":"","EditWindow":""},{"attrCap":"Var 1 init value","attrInput":"","EditWindow":""},{"attrCap":"Var 1 increment","attrInput":"","EditWindow":""}],"AttributeCount":5}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local row_count = math.floor((lstg.world.r - lstg.world.l) / math.max(1, self.huge_row_spacing)) + 1\nlocal row_start_x = (lstg.world.l + lstg.world.r) / 2 - (row_count - 1) * self.huge_row_spacing / 2\nlocal middle_column = math.floor(row_count / 2) -- 从0计数的中央列\nlocal refill_direction = row_direction -- 锁定本排方向，供补弹任务使用\nlocal row_birth = self.timer -- 用于补弹与原本一排的高度对齐","EditWindow":"code"}],"AttributeCount":1}
8,{"$type":".General.Repeat, LuaSTGEditorSharp","Attributes":[{"attrCap":"Times","attrInput":"row_count","EditWindow":"yield"},{"$type":".DependencyAttrItem, ","attrCap":"Number of Var","attrInput":"1","EditWindow":""},{"attrCap":"Var 1 name","attrInput":"column","EditWindow":""},{"attrCap":"Var 1 init value","attrInput":"0","EditWindow":""},{"attrCap":"Var 1 increment","attrInput":"1","EditWindow":""}],"AttributeCount":5}
9,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"column ~= middle_column","EditWindow":""}],"AttributeCount":1}
10,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
11,{"$type":".Bullet.CreateBullet, ","Attributes":[{"attrCap":"Name","attrInput":"\"GreenHugeRow\"","EditWindow":"bulletDef"},{"attrCap":"Position","attrInput":"row_start_x + column * self.huge_row_spacing, self.huge_row_y","EditWindow":"position"},{"attrCap":"Parameters","attrInput":"self, self.huge_row_speed, row_direction * self.huge_row_horizontal_speed","EditWindow":"bulletParam"}],"AttributeCount":3}
8,{"$type":".Task.TaskNode, ","Attributes":[]}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local side_direction = refill_direction\nlocal horizontal_speed = math.max(0.001, math.abs(self.huge_row_horizontal_speed))\nlocal side_interval = math.max(1, math.floor(self.huge_row_spacing / horizontal_speed + 0.5))\nlocal side_x = side_direction < 0 and (lstg.world.r + self.huge_row_radius + 1) or (lstg.world.l - self.huge_row_radius - 1)\nlocal last_y = lstg.world.b - self.huge_row_radius -- 整排完全离开板底才停止补弹\nlocal side_count = math.max(0, math.floor((self.huge_row_y - last_y) / math.max(0.001, self.huge_row_speed) / side_interval) + 1)","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Repeat, LuaSTGEditorSharp","Attributes":[{"attrCap":"Times","attrInput":"side_count","EditWindow":"yield"},{"$type":".DependencyAttrItem, ","attrCap":"Number of Var","attrInput":"1","EditWindow":""},{"attrCap":"Var 1 name","attrInput":"side_step","EditWindow":""},{"attrCap":"Var 1 init value","attrInput":"0","EditWindow":""},{"attrCap":"Var 1 increment","attrInput":"1","EditWindow":""}],"AttributeCount":5}
10,{"$type":".Bullet.CreateBullet, ","Attributes":[{"attrCap":"Name","attrInput":"\"GreenHugeRow\"","EditWindow":"bulletDef"},{"attrCap":"Position","attrInput":"side_x, self.huge_row_y - (self.timer - row_birth) * self.huge_row_speed","EditWindow":"position"},{"attrCap":"Parameters","attrInput":"self, self.huge_row_speed, side_direction * self.huge_row_horizontal_speed","EditWindow":"bulletParam"}],"AttributeCount":3}
10,{"$type":".Task.TaskWait, ","Attributes":[{"attrCap":"Time","attrInput":"side_interval","EditWindow":"yield"}],"AttributeCount":1}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"row_direction = -row_direction","EditWindow":"code"}],"AttributeCount":1}
8,{"$type":".Task.TaskWait, ","Attributes":[{"attrCap":"Time","attrInput":"self.huge_row_interval","EditWindow":"yield"}],"AttributeCount":1}
