7,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"鹿弹外观：八张deer图按生成顺序循环","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_deer_size = 48 -- 每张鹿图缩放后的画布宽度（游戏坐标）","EditWindow":"code"}],"AttributeCount":1}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_deer_serial = 0 -- 全部四角追踪弹共享的序号，从deer0开始","EditWindow":"code"}],"AttributeCount":1}
8,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"按创建顺序为deer0～deer7循环；显示大小单独调，chase_hitbox判定不变。","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2}
7,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"鹿弹判定与四角出生位置（贴图在Resources）","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_hitbox = 8 -- 维持ball_big判定，换贴图也不改变判定","EditWindow":"code"}],"AttributeCount":1}
8,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"八张图在Resources节点选择文件；鹿弹保持chase_hitbox设置的圆形判定，改显示尺寸不改判定。","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_spawn_margin = 25 -- 48宽鹿图的半径24 + 1，出生时在屏幕外","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_spawn_interval = 300 -- 每5秒四角同时生成（60FPS）","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_track_frames = 600 -- 每颗追踪弹出生后累计10秒，停顿时间也计入","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_far_speed = 1.0 -- 你设置的较远追踪速度","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_near_speed = 0.5 -- 你设置的接近自机时的速度","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_final_speed = 0.5 -- 10秒时若恰好静止，按自机方向直飞的速度","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_slow_radius = 60","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_slow_jitter = 12 -- 各颗子弹各自浮动±12","EditWindow":"code"}],"AttributeCount":1}
