5,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"绿色大玉保留敌弹判定；从上边界之外生成，进屏幕后正常出界删除。","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2}
5,{"$type":".Bullet.BulletInit, ","Attributes":[{"attrCap":"Parameter List","attrInput":"owner,speed,horizontal_speed","EditWindow":""},{"attrCap":"Style","attrInput":"ball_huge","EditWindow":"bulletStyle"},{"attrCap":"Color","attrInput":"COLOR_GREEN","EditWindow":"color"},{"attrCap":"Stay on create","attrInput":"false","EditWindow":"bool"},{"attrCap":"Destroyable","attrInput":"true","EditWindow":"bool"}],"AttributeCount":5}
6,{"$type":".Object.SetVelocity, ","Attributes":[{"attrCap":"Target","attrInput":"self","EditWindow":"target"},{"attrCap":"Velocity","attrInput":"speed","EditWindow":"velocity"},{"attrCap":"Angle","attrInput":"270","EditWindow":"rotation"},{"attrCap":"Aim to Player","attrInput":"false","EditWindow":"bool"},{"attrCap":"Set Rotation","attrInput":"false","EditWindow":"bool"}],"AttributeCount":5}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.vx = horizontal_speed","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.bound = false -- 出生在屏幕外时暂不触发引擎出界删除","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.layer = LAYER_ENEMY_BULLET - 1 -- 金色子弹绘制在绿色大玉之上\nself.huge_gold_owner = owner\nself.huge_gold_lane_spacing = math.max(0.001, math.abs(horizontal_speed) * owner.huge_gold_interval)\nlocal lane_index = (self.x - lstg.world.l) / self.huge_gold_lane_spacing\nif horizontal_speed < 0 then\n    self.huge_gold_next_x = lstg.world.l + (math.ceil(lane_index) - 1) * self.huge_gold_lane_spacing\nelse\n    self.huge_gold_next_x = lstg.world.l + (math.floor(lane_index) + 1) * self.huge_gold_lane_spacing\nend","EditWindow":"code"}],"AttributeCount":1}
5,{"$type":".Object.CallBackFunc, ","Attributes":[{"attrCap":"Event type","attrInput":"frame","EditWindow":"event"}],"AttributeCount":1}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"task.Do(self)\nif self.y < lstg.world.b - 33 then\n    RawDel(self) -- 补弹即使没有完全进入画面，也会在离开底边后删除\n    return\nend\nif self.x >= lstg.world.l and self.x <= lstg.world.r and self.y >= lstg.world.b and self.y <= lstg.world.t then\n    self.bound = true\nend","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"IsValid(self.huge_gold_owner) and self.bound and self.huge_gold_next_x >= lstg.world.l and self.huge_gold_next_x <= lstg.world.r and self.y > lstg.world.b and ((self.vx < 0 and self.x <= self.huge_gold_next_x) or (self.vx > 0 and self.x >= self.huge_gold_next_x))","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
8,{"$type":".Bullet.CreateBullet, ","Attributes":[{"attrCap":"Name","attrInput":"\"HugeGoldenShot\"","EditWindow":"bulletDef"},{"attrCap":"Position","attrInput":"self.huge_gold_next_x, self.y","EditWindow":"position"},{"attrCap":"Parameters","attrInput":"self.huge_gold_owner.huge_gold_speed, 270","EditWindow":"bulletParam"}],"AttributeCount":3}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.huge_gold_next_x = self.huge_gold_next_x + (self.vx < 0 and -1 or 1) * self.huge_gold_lane_spacing","EditWindow":"code"}],"AttributeCount":1}
4,{"$type":".Bullet.BulletDefine, ","Attributes":[{"attrCap":"Name","attrInput":"HugeGoldenShot","EditWindow":""},{"attrCap":"Difficulty","attrInput":"All","EditWindow":"objDifficulty"}],"AttributeCount":2,"IsExpanded":false}
