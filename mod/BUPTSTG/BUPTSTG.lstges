5,{"$type":".Object.ObjectInit, ","Attributes":[{"attrCap":"Parameter List","attrInput":"owner,deer_index","EditWindow":""},{"attrCap":"Image","attrInput":"\"image:deer0\"","EditWindow":"objimage"},{"attrCap":"Layer","attrInput":"LAYER_ENEMY_BULLET - 1","EditWindow":"layer"},{"attrCap":"Group","attrInput":"GROUP_ENEMY_BULLET","EditWindow":"group"},{"attrCap":"Hide","attrInput":"false","EditWindow":"bool"},{"attrCap":"Bound","attrInput":"false","EditWindow":"bool"},{"attrCap":"Auto Rotation","attrInput":"false","EditWindow":"bool"},{"attrCap":"HP","attrInput":"1","EditWindow":""},{"attrCap":"Collision","attrInput":"true","EditWindow":"bool"}],"AttributeCount":9}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"初始化①：判定、鹿图编号与显示尺寸","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.a, self.b = 8,8","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.rect = false","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_owner = owner","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_deer_index = deer_index -- 第i颗鹿弹使用deer(i mod 8)","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.img = \"image:deer\" .. self.chase_deer_index","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local deer_width = ({160,240,240,240,240,240,240,120})[self.chase_deer_index + 1]","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.hscale, self.vscale = owner.chase_deer_size / deer_width, owner.chase_deer_size / deer_width","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"初始化②：每颗弹独立随机的减速与停顿距离","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_slow_radius = owner.chase_slow_radius + (math.random() * 2 - 1) * owner.chase_slow_jitter","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_stop_radius = owner.chase_stop_radius + (math.random() * 2 - 1) * owner.chase_stop_jitter","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"初始化③：追踪、暂停与直飞状态","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_state = \"follow\" -- follow追踪、pause暂停、straight固定直飞","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_pause_left = 0","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_rearm_left = 0","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_visited_screen = false","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_last_px = IsValid(player) and player.x or self.x","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_last_py = IsValid(player) and player.y or self.y","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.vx, self.vy = 0, 0","EditWindow":"code"}],"AttributeCount":1}
5,{"$type":".Object.CallBackFunc, ","Attributes":[{"attrCap":"Event type","attrInput":"frame","EditWindow":"event"}],"AttributeCount":1}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"逐帧①：Boss结束与最终直飞出屏清理","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local owner = self.chase_owner","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"not IsValid(owner) or owner.hp <= 0","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"RawDel(self)","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"return","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"self.x >= lstg.world.l and self.x <= lstg.world.r and self.y >= lstg.world.b and self.y <= lstg.world.t","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_visited_screen = true","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"self.chase_state == \"straight\"","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"self.chase_visited_screen and (self.x < lstg.world.l - owner.chase_spawn_margin or self.x > lstg.world.r + owner.chase_spawn_margin or self.y < lstg.world.b - owner.chase_spawn_margin or self.y > lstg.world.t + owner.chase_spawn_margin)","EditWindow":""}],"AttributeCount":1}
10,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
11,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"RawDel(self)","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"return -- 直飞阶段不再改变vx与vy","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"逐帧②：记录自机位置与距离","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local target = player","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"not IsValid(target)","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.vx, self.vy = 0, 0","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"return","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local dx, dy = target.x - self.x, target.y - self.y","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local dist = math.sqrt(dx * dx + dy * dy)","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local player_dx, player_dy = target.x - self.chase_last_px, target.y - self.chase_last_py","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_last_px, self.chase_last_py = target.x, target.y","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"逐帧③：生成满10秒，锁定当前速度和方向","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"self.timer >= owner.chase_track_frames","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"self.chase_state == \"pause\" or self.vx * self.vx + self.vy * self.vy < 0.0001","EditWindow":""}],"AttributeCount":1}
10,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
11,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local mx, my = target.__move_dx or 0, target.__move_dy or 0","EditWindow":"code"}],"AttributeCount":1}
11,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local length = math.sqrt(mx * mx + my * my)","EditWindow":"code"}],"AttributeCount":1}
11,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"length < 0.01","EditWindow":""}],"AttributeCount":1}
12,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
13,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"mx, my = player_dx, player_dy","EditWindow":"code"}],"AttributeCount":1}
13,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"length = math.sqrt(mx * mx + my * my)","EditWindow":"code"}],"AttributeCount":1}
11,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"length < 0.01","EditWindow":""}],"AttributeCount":1}
12,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
13,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"mx, my, length = dx, dy, dist -- 自机未移动时朝其当前位置飞去","EditWindow":"code"}],"AttributeCount":1}
11,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"length < 0.01","EditWindow":""}],"AttributeCount":1}
12,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
13,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"mx, my, length = 0, -1, 1","EditWindow":"code"}],"AttributeCount":1}
11,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.vx = owner.chase_final_speed * mx / length","EditWindow":"code"}],"AttributeCount":1}
11,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.vy = owner.chase_final_speed * my / length","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_state = \"straight\" -- 移动中的弹保留原有vx/vy","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"return","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"逐帧④：暂停结束后重新追踪","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"self.chase_state == \"pause\"","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.vx, self.vy = 0, 0","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_pause_left = self.chase_pause_left - 1","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"self.chase_pause_left <= 0","EditWindow":""}],"AttributeCount":1}
10,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
11,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_state = \"follow\"","EditWindow":"code"}],"AttributeCount":1}
11,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_rearm_left = owner.chase_rearm_frames","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"return -- 停顿帧不进入下方追踪逻辑","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"逐帧⑤：持续追踪、接近后减速、到点暂停","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"self.chase_rearm_left > 0","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_rearm_left = self.chase_rearm_left - 1","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"self.chase_rearm_left <= 0 and dist <= self.chase_stop_radius","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_state = \"pause\"","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.chase_pause_left = math.random(math.floor(owner.chase_pause_min), math.floor(owner.chase_pause_max))","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.vx, self.vy = 0, 0","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"return","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.IfNode, LuaSTGEditorSharp","Attributes":[{"attrCap":"Condition","attrInput":"dist > 0.01","EditWindow":""}],"AttributeCount":1}
8,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local speed = dist <= self.chase_slow_radius and owner.chase_near_speed or owner.chase_far_speed","EditWindow":"code"}],"AttributeCount":1}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.vx, self.vy = speed * dx / dist, speed * dy / dist","EditWindow":"code"}],"AttributeCount":1}
8,{"$type":".General.IfElse, LuaSTGEditorSharp","Attributes":[]}
9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.vx, self.vy = 0, 0","EditWindow":"code"}],"AttributeCount":1}
3,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"北斗「虹色之花与七石之狼」","EditWindow":""}],"AttributeCount":1,"IsExpanded":false}
4,{"$type":".Bullet.BulletDefine, ","Attributes":[{"attrCap":"Name","attrInput":"BD_Star","EditWindow":""},{"attrCap":"Difficulty","attrInput":"All","EditWindow":"objDifficulty"}],"AttributeCount":2}
5,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"七个实例共用此定义。发射源名称在 self.bd_name，坐标在 self.x / self.y。","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2}
5,{"$type":".Bullet.BulletInit, ","Attributes":[{"attrCap":"Parameter List","attrInput":"owner, name, offset_x, offset_y, star_color","EditWindow":""},{"attrCap":"Style","attrInput":"ball_light","EditWindow":"bulletStyle"},{"attrCap":"Color","attrInput":"star_color","EditWindow":"color"},{"attrCap":"Stay on create","attrInput":"false","EditWindow":"bool"},{"attrCap":"Destroyable","attrInput":"false","EditWindow":"bool"}],"AttributeCount":5}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.bd_owner = owner\nself.bd_token = owner.bd_token\nself.bd_name = name\nself.bd_dx, self.bd_dy = offset_x, offset_y","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"光玉颜色由创建各星点时传入的 star_color 控制；J红 I橙 H黄 G绿 F青 E蓝 D紫。跳过出生雾化以保持图层稳定。","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.class = self.logclass","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.bound = false\nself.colli = true\nself.group = GROUP_INDES\nself.layer = LAYER_ENEMY_BULLET + 5\nself.hscale, self.vscale = owner.bd_star_scale, owner.bd_star_scale","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"发弹说明：由Boss统一安排顺序","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"开花弹在 Boss → on start → Create task → 05 顺序开花 中修改。","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2}
5,{"$type":".Object.CallBackFunc, ","Attributes":[{"attrCap":"Event type","attrInput":"frame","EditWindow":"event"}],"AttributeCount":1}
6,{"$type":".Object.DefaultAction, ","Attributes":[]}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local owner = self.bd_owner\nif not IsValid(owner) or owner.bd_token ~= self.bd_token then\n    RawDel(self)\n    return\nend","EditWindow":"code"}],"AttributeCount":1}
6,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"旋转公式：由初始偏移计算，避免逐帧累计变形","EditWindow":""}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local c, s = cos(owner.bd_angle), sin(owner.bd_angle)","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.x = owner.bd_kx + owner.bd_scale * (self.bd_dx * c - self.bd_dy * s)","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.y = owner.bd_ky + owner.bd_scale * (self.bd_dx * s + self.bd_dy * c)","EditWindow":"code"}],"AttributeCount":1}
4,{"$type":".Bullet.BulletDefine, ","Attributes":[{"attrCap":"Name","attrInput":"BD_Flower","EditWindow":""},{"attrCap":"Difficulty","attrInput":"All","EditWindow":"objDifficulty"}],"AttributeCount":2}
5,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"开花弹：小圆弹，自出生位置沿指定方向直线飞行，有正常敌弹判定。","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2}
